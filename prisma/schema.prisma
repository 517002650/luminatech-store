generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  name               String               @default("")
  bannedFromReviews  Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  orders             Order[]
  wishlist           WishlistItem[]
  reviews            Review[]
  resetTokens        PasswordResetToken[]
  addresses          UserAddress[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String
  value     Float
  minOrder  Float     @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ShippingSettings {
  id                    String   @id @default("default")
  freeShippingThreshold Float    @default(100)
  flatRate              Float    @default(15.99)
  euRate                Float    @default(12.99)
  countryRates          String   @default("{}")
  updatedAt             DateTime @updatedAt
}

model SiteSettings {
  id                      String   @id @default("default")
  reviewModerationEnabled Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

/** Back-office staff (not storefront customers). */
model AdminAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  /** owner | admin — only owner manages team accounts */
  role         String   @default("admin")
  active       Boolean  @default(true)
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  nameEn    String
  nameZh    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  sku           String
  brand         String
  nameEn        String
  nameZh        String
  shortDescEn   String
  shortDescZh   String
  descriptionEn String
  descriptionZh String
  categoryEn    String
  categoryZh    String
  categoryKey   String         @default("fixtures")
  price         Float
  compareAtPrice Float?
  image         String
  images        String
  specsEn       String
  specsZh       String
  highlightsEn  String
  highlightsZh  String
  stock         Int            @default(100)
  featured      Boolean        @default(false)
  requiresFreight Boolean      @default(false)
  active        Boolean        @default(true)
  warranty      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlist      WishlistItem[]
  reviews       Review[]
  downloads     ProductDownload[]
  variants      ProductVariant[]
}

/** Sellable SKU under a product — own price, stock, and option label. */
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  nameEn         String   @default("")
  nameZh         String   @default("")
  price          Float
  compareAtPrice Float?
  stock          Int      @default(0)
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId, active])
}

model ProductDownload {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String
  version     String
  titleEn     String
  titleZh     String
  notesEn     String   @default("")
  notesZh     String   @default("")
  fileUrl     String
  fileName    String
  fileSize    Int      @default(0)
  isLatest    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, type])
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  email           String   @default("")
  subtotal        Float    @default(0)
  shippingFee     Float    @default(0)
  taxAmount       Float    @default(0)
  discountAmount  Float    @default(0)
  couponCode      String   @default("")
  total           Float
  status          String   @default("paid")
  shippingCarrier String   @default("")
  trackingNumber  String   @default("")
  paymentMethod   String
  paymentId       String?  @unique
  /** True when inventory was decremented for this order (refund should restock). */
  /** Cumulative Stripe refunds in USD (partial refunds accumulate here). */
  refundedAmount  Float    @default(0)
  stockApplied    Boolean  @default(true)
  items           String
  shippingAddress String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserAddress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Default")
  isDefault  Boolean  @default(false)
  name       String
  phone      String   @default("")
  email      String   @default("")
  line1      String
  line2      String   @default("")
  city       String
  state      String   @default("")
  country    String
  postalCode String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String
  rating           Int
  title            String
  content          String
  verifiedPurchase Boolean  @default(false)
  approved         Boolean  @default(true)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([approved, createdAt])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  locale    String   @default("en")
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  email     String
  reason    String
  details   String   @default("")
  status    String   @default("requested")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}
