# Database
# Local SQLite: file:./prisma/dev.db  (use with npm run db:local:* / npm run dev)
# Production (Vercel): Neon PostgreSQL connection string
DATABASE_URL="file:./prisma/dev.db"

# Optional: Neon URL for backup / sync-local without changing DATABASE_URL
# BACKUP_DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"
# RESTORE_DATABASE_URL="file:./prisma/dev.db"

# App URL (change to your domain when deploying)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Optional: comma-separated. Default: card,alipay,wechat_pay
# Enable Alipay & WeChat Pay first: Stripe Dashboard → Settings → Payment methods
STRIPE_PAYMENT_METHODS=card,alipay,wechat_pay
# Stripe Webhook — Dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal — get sandbox credentials at https://developer.paypal.com
# Disabled by default until server-side Orders capture is implemented.
# Both flags required to accept PayPal checkouts:
# NEXT_PUBLIC_PAYPAL_ENABLED=true
# PAYPAL_ENABLED=true
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
# NEXT_PUBLIC_PAYPAL_ENABLED=false
# PAYPAL_ENABLED=false

# Admin — REQUIRED in production (min 12 chars; admin123 blocked on Vercel)
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional separate session signing secret (recommended)
# ADMIN_SECRET=another-long-random-string
# FORCE_SECURE_ADMIN=true

# Customer session signing (optional; falls back to ADMIN_PASSWORD)
USER_SESSION_SECRET=change-this-user-session-secret

# Cloudinary — REQUIRED for image uploads on Vercel (free tier available)
# Sign up: https://cloudinary.com
# Local dev works without these (saves to public/uploads/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP — for shipping notification emails
# Gmail example: smtp.gmail.com, port 587, use App Password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
SMTP_FROM="LuminaTech <noreply@yourdomain.com>"
STORE_NAME=LuminaTech

# Contact email shown on the contact page
CONTACT_EMAIL=support@luminatech.com

# Shipping & tax (optional overrides)
FREE_SHIPPING_THRESHOLD=100
SHIPPING_FLAT_RATE=15.99
SHIPPING_US=5.99
SHIPPING_EU=12.99
DEFAULT_TAX_RATE=0
TAX_US=0.08
TAX_GB=0.20
TAX_DE=0.19
TAX_EU_DEFAULT=0.21
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=100
