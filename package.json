{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.local.prisma && next dev",
    "build": "prisma generate && prisma db push && npm run db:seed && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:local:generate": "prisma generate --schema=prisma/schema.local.prisma",
    "db:local:push": "prisma db push --schema=prisma/schema.local.prisma",
    "db:local:setup": "npm run db:local:generate && npm run db:local:push && npm run db:seed:brands && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:brands": "tsx prisma/seed-brand-demo.ts",
    "db:studio": "prisma studio --schema=prisma/schema.local.prisma",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:sync:local": "tsx scripts/db-sync-local.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "nodemailer": "^9.0.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.5.0",
    "tsx": "^4.23.12",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
